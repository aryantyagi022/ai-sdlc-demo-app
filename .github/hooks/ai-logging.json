{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": ".github/hooks/scripts/log-event.sh sessionStart",
        "cwd": ".",
        "timeoutSec": 10
      }
    ],
    "sessionEnd": [
      {
        "type": "command",
        "bash": ".github/hooks/scripts/log-event.sh sessionEnd",
        "cwd": ".",
        "timeoutSec": 10
      }
    ],
    "userPromptSubmitted": [
      {
        "type": "command",
        "bash": ".github/hooks/scripts/log-prompt.sh",
        "cwd": ".",
        "timeoutSec": 10
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "bash": ".github/hooks/scripts/guard.sh",
        "cwd": ".",
        "timeoutSec": 10
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "matcher": "ask_user",
        "bash": ".github/hooks/scripts/log-ask-user.sh answered",
        "cwd": ".",
        "timeoutSec": 10
      },
      {
        "type": "command",
        "bash": ".github/hooks/scripts/log-tool.sh success",
        "cwd": ".",
        "timeoutSec": 10
      }
    ],
    "postToolUseFailure": [
      {
        "type": "command",
        "matcher": "ask_user",
        "bash": ".github/hooks/scripts/log-ask-user.sh declined",
        "cwd": ".",
        "timeoutSec": 10
      },
      {
        "type": "command",
        "bash": ".github/hooks/scripts/log-tool.sh failure",
        "cwd": ".",
        "timeoutSec": 10
      }
    ],
    "subagentStart": [
      {
        "type": "command",
        "bash": ".github/hooks/scripts/log-event.sh subagentStart",
        "cwd": ".",
        "timeoutSec": 10
      }
    ],
    "subagentStop": [
      {
        "type": "command",
        "bash": ".github/hooks/scripts/log-event.sh subagentStop",
        "cwd": ".",
        "timeoutSec": 10
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "bash": ".github/hooks/scripts/log-event.sh agentStop",
        "cwd": ".",
        "timeoutSec": 10
      }
    ],
    "errorOccurred": [
      {
        "type": "command",
        "bash": ".github/hooks/scripts/log-event.sh errorOccurred",
        "cwd": ".",
        "timeoutSec": 10
      }
    ],
    "notification": [
      {
        "type": "command",
        "bash": ".github/hooks/scripts/log-event.sh notification",
        "cwd": ".",
        "timeoutSec": 10
      }
    ]
  }
}
